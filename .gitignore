app.*.symbols
app.*.map.json

# Local SDK / tool checkouts (root-level Flutter SDK only; do not match
# Flutter's per-platform `flutter/` and `Flutter/` sub-directories)
/flutter/
.fvm/

# Node.js / monorepo tooling
node_modules/
.husky/_
.lint-staged-cache/

# Python (if any helper scripts land later)
__pycache__/
*.pyc
.claude/
.venv/
ml-service/.venv/

# Redis runtime dump (not source)
*.rdb
dump.rdb
