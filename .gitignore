# Secrets / keys
*.pem
*.key
*.jks
*.keystore
*.p12

# Android signing
reverse_match/android/key.properties

# Firebase / Google service credentials (downloaded from console, never commit)
reverse_match/android/app/google-services.json
reverse_match/ios/Runner/GoogleService-Info.plist
backend/serviceAccountKey.json
backend/firebase-service-account.json
**/firebase-service-account.json
**/serviceAccountKey.json

# Logs
*.log
logs/

# Local caches and temp files
.cache/
tmp/
temp/
.tmp_*
.eslintcache
*.tsbuildinfo

# Test coverage and build outputs
coverage/
.nyc_output/
*.lcov
dist/
build/

# Flutter / Dart generated files
reverse_match/.dart_tool/
reverse_match/.flutter-plugins
reverse_match/.flutter-plugins-dependencies
reverse_match/.pub/
reverse_match/.pub-cache/
reverse_match/build/
reverse_match/coverage/
