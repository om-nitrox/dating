# ============================================
# Reverse Match Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
#
# Markers (Phase 1.6):
#   # REQUIRED          — must be set in every environment
#   # REQUIRED in prod  — must be set when NODE_ENV=production; optional in dev/test
#   # Optional          — has a sane default
#
# Validation is performed at boot by `src/config/index.js`. Run
# `npm run check:env` to validate without booting the server.

# ---- Core ----
NODE_ENV=development                         # Optional. development | test | staging | production
PORT=5000                                    # Optional. Default: 5000. On Zoho Catalyst AppSail the platform injects X_ZOHO_CATALYST_LISTEN_PORT, which the app maps onto PORT automatically.
# ENABLE_INPROCESS_CRON=true                 # Optional. Force the in-process node-cron scheduler ON in production (long-lived/PM2 hosts). On AppSail leave unset and use Catalyst Cron -> /internal/cron/*.
# CRON_SECRET=                               # Shared secret for /internal/cron/* (sent as X-Cron-Secret by Catalyst Cron). Set in any deploy that drives crons via HTTP.

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/reverse_match   # REQUIRED

# ---- Redis ----
REDIS_URL=redis://localhost:6379             # REQUIRED in prod. Source of truth for rate limits, idempotency cache, pub/sub.

# ---- JWT ----
JWT_ACCESS_SECRET=your-access-secret-min-32-chars     # REQUIRED. min 16 chars.
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars   # REQUIRED. min 16 chars.
JWT_ACCESS_EXPIRY=15m                        # Optional. Default: 15m
JWT_REFRESH_EXPIRY=7d                        # Optional. Default: 7d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com   # REQUIRED in prod

# ---- Email / OTP ----
# When SMTP credentials are missing, OTPs are NOT delivered. We never log the
# code itself in any environment.
SMTP_HOST=smtp.gmail.com                     # REQUIRED in prod. Default: smtp.gmail.com
SMTP_PORT=587                                # Optional. Default: 587
SMTP_USER=your-email@gmail.com               # REQUIRED in prod
SMTP_PASS=your-app-password                  # REQUIRED in prod
OTP_EXPIRY_MINUTES=5                         # Optional. Default: 5
OTP_PEPPER=                                  # REQUIRED in prod. Dedicated HMAC key for OTP hashing; decoupled from JWT_ACCESS_SECRET.

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name        # REQUIRED in prod
CLOUDINARY_API_KEY=your-api-key              # REQUIRED in prod
CLOUDINARY_API_SECRET=your-api-secret        # REQUIRED in prod
CLOUDINARY_MODERATION=false                  # Optional. Set to 'true' to enable AI image moderation (requires Cloudinary paid plan)

# ---- Firebase ----
# Download service account JSON from Firebase Console > Project Settings > Service Accounts.
# Provide EITHER the file path (local/dev, file-mount platforms) OR the inline
# JSON (env-only platforms like Zoho Catalyst AppSail). One of the two is REQUIRED in prod.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json   # REQUIRED in prod (or use FIREBASE_SERVICE_ACCOUNT_JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON=                                # Alternative to the path: the full service-account JSON as a single-line string.

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...                # REQUIRED in prod
STRIPE_WEBHOOK_SECRET=whsec_...              # REQUIRED in prod. Without this, boost activation is spoofable.

# ---- App URLs ----
APP_BASE_URL=http://localhost:5000           # REQUIRED in prod. Public backend URL (e.g., https://api.yourdomain.com).
APP_DEEP_LINK_SCHEME=reversematch            # Optional. Deep link scheme registered in Flutter app.

# ---- Legal Pages ----
PRIVACY_POLICY_URL=                          # Optional but REQUIRED for app store submission.
TERMS_OF_SERVICE_URL=                        # Optional but REQUIRED for app store submission.

# ---- Public App Metadata (GET /config) ----
SUPPORT_EMAIL=support@reversematch.app       # Optional. Surfaced to clients via /config.
MIN_APP_VERSION=1.0.0                        # Optional. Force-update gate via /config.

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000           # REQUIRED in prod. Comma-separated allowed origins. In dev mode, all origins allowed.

# ---- Sentry ----
SENTRY_DSN=                                  # Optional. Error tracking.

# ---- Rate Limiting ----
LIKE_RATE_LIMIT_WINDOW_MS=3600000            # Optional. Default: 1 hour (ms)
LIKE_RATE_LIMIT_MAX=100                      # Optional. Default: 100 likes per window

# ---- Request Limits ----
MAX_REQUEST_BODY_SIZE=10mb                   # Optional. Default: 10mb
SOCKET_MAX_PAYLOAD_BYTES=65536               # Optional. Default: 64KB
MAX_PHOTO_SIZE_BYTES=5242880                 # Optional. Per-file upload cap (default 5MB)

# ---- Mongo Transactions ----
MONGO_TRANSACTIONS_ENABLED=true              # Optional. Default: true. Set false for standalone local mongo.

# ---- Moderation ----
REPORT_AUTO_SUSPEND_THRESHOLD=5              # Optional. Default: 5

# ---- BullMQ / Worker ----
WORKER_METRICS_PORT=9091                     # Optional. Default: 9091
BULLMQ_QUEUE_PREFIX=rm                       # Optional. Override per-env when sharing Redis.

# ---- Idempotency (Phase 1.4) ----
IDEMPOTENCY_TTL_SECONDS=86400                # Optional. Default: 24h
IDEMPOTENCY_INFLIGHT_TIMEOUT_MS=8000         # Optional. Default: 8s

# ---- Media Reaper (Phase 1.2) ----
MEDIA_REAPER_INTERVAL_MS=300000              # Optional. Default: 5 minutes

# ---- ML Matchmaker Microservice ----
# Empty ML_SERVICE_URL disables the integration; idealMatch.service.js then
# uses its legacy one-hot cosine fallback. When docker-composing the whole
# stack the URL defaults to http://ml-service:8000.
ML_SERVICE_URL=                              # Optional. e.g. http://ml-service:8000
ML_SERVICE_API_KEY=                          # Optional. Shared secret matching ml-service ML_SERVICE_API_KEY.
ML_SERVICE_TIMEOUT_MS=2500                   # Optional. Default: 2500ms
