# Mongo — same DB the Node backend uses.
MONGO_URI=mongodb://mongo:27017/reverse_match

# HTTP
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Shared secret with the Node backend. Leave empty to disable auth (dev only).
ML_SERVICE_API_KEY=

# Embedding model — small, fast, 384-dim. Override for higher quality.
EMBED_MODEL=all-MiniLM-L6-v2
TEXT_EMBED_DIM=384

# Retrieval
CANDIDATES_K=100
TOP_K=20
FAISS_NLIST=100

# Matchmaking unlock thresholds
IDEAL_MATCH_MIN_SWIPES=20
IDEAL_MATCH_MIN_RIGHT=10

# Bandit
EXPLORE_ALPHA=1.0
EXPLORE_BETA=1.0
EXPLORE_WEIGHT=0.2

# Time decay (days)
TIME_DECAY_HALF_LIFE=7.0

# Build the index from Mongo on boot. Disable for unit-test envs.
AUTO_REBUILD_ON_BOOT=true
REBUILD_MIN_USERS=1

LOG_LEVEL=INFO
DATA_DIR=/app/data
