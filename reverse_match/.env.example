# Reverse Match Flutter app — environment template.
# Copy to `.env`, `.env.staging`, or `.env.production` and fill in real values.
# Never commit the populated files.

# Base URL for the backend REST API (must include the /api/v1 suffix).
# Android emulator localhost example:  http://10.0.2.2:5000/api/v1
# iOS simulator / web example:         http://localhost:5000/api/v1
API_BASE_URL=

# Base URL for the Socket.IO server (no path suffix).
SOCKET_URL=
